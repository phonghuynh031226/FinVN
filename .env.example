# Bank Connector Backend
BANK_CONNECTOR_PORT=8787
WEB_ORIGIN=http://localhost:5173

# Web frontend: set in web/.env.local
VITE_BANK_CONNECTOR_URL=http://localhost:8787

EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SePay Webhook & API Configuration (CHỈ cấu hình trên Backend / Supabase Edge Functions / VPS)
# TUYỆT ĐỐI KHÔNG commit hay đưa vào code mobile
SEPAY_WEBHOOK_SECRET=your_sepay_webhook_api_key_or_secret
SEPAY_API_KEY=your_sepay_api_token
SEPAY_BASE_URL=https://my.sepay.vn/userapi

# Supabase Service Role Key (Chỉ dùng cho Edge Functions xử lý Webhook và migration)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
