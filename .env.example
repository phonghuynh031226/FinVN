# Bank Connector Backend
BANK_CONNECTOR_PORT=8787
WEB_ORIGIN=http://localhost:5173
APP_ENV=development
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finvn_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep this secret in the production host's secret manager; never commit a real value.
BANK_CREDENTIALS_ACTIVE_KEY=key-v1
BANK_CREDENTIALS_KEYRING=key-v1:REPLACE_WITH_BASE64_32_BYTE_KEY

# Web frontend: set in web/.env.local
VITE_BANK_CONNECTOR_URL=http://localhost:8787

